# Tajne za LOKALNO pokretanje edge funkcije r2-presign (otprema na blog).
#
# Kopiraj u supabase/functions/.env i popuni pravim vrijednostima iz
# Cloudflare R2 (ima ih Filip — API token sa Object Read & Write na bucket).
# .env je u .gitignore i NIKAD ne ide u repo (javan je).
#
# Bez ovoga otprema na blog IZ LOKALNE aplikacije vraća
# "Edge Function returned a non-2xx status code" — funkcija nema ključeve.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=gymapp-blog

{
  "name": "gym-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/check-db.mjs && ng serve",
    "start:cloud": "ng serve --configuration cloud",
    "start:lan": "node scripts/check-db.mjs && ng serve --host 0.0.0.0",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "setup": "supabase start && npm run db:storage",
    "db:start": "supabase start",
    "db:up": "supabase migration up --local",
    "db:stop": "supabase stop",
    "db:studio": "open http://127.0.0.1:54323",
    "db:storage": "node scripts/sync-storage.mjs",
    "db:reset": "supabase db reset && npm run db:storage"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^16.2.0",
    "@angular/common": "^16.2.0",
    "@angular/compiler": "^16.2.0",
    "@angular/core": "^16.2.0",
    "@angular/forms": "^16.2.0",
    "@angular/platform-browser": "^16.2.0",
    "@angular/platform-browser-dynamic": "^16.2.0",
    "@angular/router": "^16.2.0",
    "@angular/service-worker": "^16.2.0",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@supabase/supabase-js": "^2.110.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.13.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.2.16",
    "@angular/cli": "^16.2.16",
    "@angular/compiler-cli": "^16.2.0",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^26.1.1",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "supabase": "^2.109.1",
    "typescript": "~5.1.3"
  }
}

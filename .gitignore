# See http://help.github.com/ignore-files/ for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log
yarn-error.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Miscellaneous
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings

# System files
.DS_Store
Thumbs.db

# Claude Code — agenti i CLAUDE.md se commit-uju, lokalne dozvole ne
.claude/settings.local.json

# Supabase — migracije, seed i config.toml SE commit-uju (to je cijela poenta);
# ignoriše se samo lokalno stanje CLI-ja
supabase/.temp/
supabase/.branches/

# R2 API ključevi za lokalno `supabase functions serve` (vidi
# supabase/functions/r2-presign) — u produkciji idu preko `supabase secrets set`,
# nikad u git.
supabase/functions/.env
supabase/.env

# Produkcijski dump baze NIKAD ne ide u git (emailovi + hashevi lozinki,
# a repo je javan). Vidi docs/03-SIGURNOST.md
*dump.sql
database/

# Registar sigurnosnih rupa — NE objavljivati dok su rupe otvorene.
# Repo je javan, a sistem koji dokument opisuje je živ i nezaštićen.
# Dijeli se direktno između saradnika. Vidi docs/03-SIGURNOST.PROCITAJ.md
docs/03-SIGURNOST.md

# Nativna ljuska zivi na grani native-app — na radnim granama su ovo samo
# ostaci builda i ne smiju u komit (git add -A ih je jednom vec pokupio).
/ios/
/android/
